# Application runtime configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_MODE=polling

# Production Webhook Configuration (used when TELEGRAM_BOT_MODE=webhook)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# Dedicated Telegram Storage Group (Supergroup ID starting with -100...)
TELEGRAM_STORAGE_GROUP_ID=-1001234567890

# Telegram MTProto Client (used ONLY for files > 20MB to bypass Bot API 20MB download limit)
# Obtain API ID and API HASH from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional Telegram session string from TelegramClient (if empty, MTProto connects using TELEGRAM_BOT_TOKEN)
TELEGRAM_SESSION_STRING=

# Super Admin Telegram Numeric IDs (comma-separated)
ADMIN_IDS=123456789

# Telegram OpenID Connect (OIDC) Web Login credentials
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://your-domain.com/auth/callback

# Session Encryption Secret
SESSION_SECRET=super_secret_session_encryption_key_change_me_in_production

# Database & Storage paths
DB_PATH=./data/database.json

# Upload Session timeout in minutes
UPLOAD_TIMEOUT_MINUTES=30

# Pagination limit for files and directories
PAGE_SIZE=30

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Optional Gemini API key if AI assistance is enabled
GEMINI_API_KEY=

